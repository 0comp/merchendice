{$SITE_HOSTNAME} {
    # Access logs are kept for 30 days, as the Privacy notice says. Rolled files older than
    # 720 hours are deleted; the small roll size keeps the live file from holding much older lines.
    log {
        output file /data/logs/access.log {
            roll_size 1MiB
            roll_keep_for 720h
        }
    }
    encode zstd gzip
    # The CREATOR demo is a made-up brand; ask crawlers not to list it. The app also sends this header.
    @exampleStore path /example-store /example-store/*
    header @exampleStore X-Robots-Tag noindex
    reverse_proxy app:3000 {
        header_up X-Real-IP {remote_host}
    }
}

www.{$SITE_HOSTNAME} {
    redir https://{$SITE_HOSTNAME}{uri} permanent
}
