# Save a PRIVATE copy as .env on the server. Do not upload keys to chat or GitHub.
SITE_HOSTNAME=merchendice.com
PUBLIC_ORIGIN=https://merchendice.com
APP_PORT=82
# If the existing reverse proxy is in Docker, use compose.proxy-network.yaml
# and set PROXY_NETWORK_NAME to the name of that proxy's existing network.
MAIL_TO=merchendices@gmail.com

# Composio mode: connect the sending Gmail account in YOUR Composio project.
EMAIL_PROVIDER=composio
COMPOSIO_API_KEY=
COMPOSIO_CONNECTED_ACCOUNT_ID=
COMPOSIO_FROM_EMAIL=merchendices@gmail.com

# Alternative matching Rigoluso/Merchendices: set EMAIL_PROVIDER=smtp.
# Enable Google 2-Step Verification and create an app password for this account.
SMTP_USER=merchendices@gmail.com
SMTP_APP_PASSWORD=
